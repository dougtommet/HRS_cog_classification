INPUT INSTRUCTIONS

  TITLE:
  x1-x3: age splines
    x4: female
    x5: black
    x6: hispanic
    x7: school years
  DATA:
  FILE = "pmm_hcap_103b_jorm_ea431093fb3a11380f18e2e2c6b93b00.dat";
  VARIABLE:
  NAMES = id HCAP16WGTR STRATUM SECU_mplus jorm;
   MISSING=.;
   idvariable = id;
  classes = c (3);
  weight = HCAP16WGTR; stratification = STRATUM; cluster = SECU_mplus;
  ANALYSIS:
  estimator = mlr;
  starts = 80;
  processors = 12;
  TYPE = complex mixture;
  MODEL:
  %OVERALL%
   [ c#1 @ -0.14665972547003 c#2 @ -0.148697417679029 ];

  [ jorm @ 3.07371926307678 ];
  jorm @ 0.426452159881592;
  %c#1%
  [ jorm @ 3.07371926307678 ];
  %c#2%
  [ jorm @ 3.66610360145569 ];
  %c#3%
  [ jorm @ 4.18556547164917 ];
  OUTPUT:
  standardized;
  SAVEDATA:
  H5RESULTS = model_103b_jorm.h5;
    SAVE = CPROBABILITIES; file = cprob_jorm.dat; FORMAT = F20.12;



