INPUT INSTRUCTIONS

  TITLE:
  x1-x3: age splines
    x4: female
    x5: black
    x6: hispanic
    x7: school years
  DATA:
  FILE = "pmm_hcap_103_jorm_e380e90d3834e72fad092592543e1297.dat";
  VARIABLE:
  NAMES = id vs1hcapdxeap HCAP16WGTR STRATUM SECU_mplus jorm;
   MISSING=.;
   idvariable = id;
  classes = cg (3);
  knownclass = cg  (vs1hcapdxeap = 1 vs1hcapdxeap = 2 vs1hcapdxeap = 3);
  weight = HCAP16WGTR; stratification = STRATUM; cluster = SECU_mplus;
  ANALYSIS:
  estimator = mlr;
  starts = 80;
  processors = 12;
  TYPE = complex mixture;
  MODEL:
  %OVERALL%

     %cg#2%
     [jorm];
     %cg#3%
     [jorm];

  OUTPUT:
  standardized;
  SAVEDATA:
  H5RESULTS = model_103_jorm.h5;



*** WARNING in MODEL command
  All variables are uncorrelated with all other variables within class.
  Check that this is what is intended.
